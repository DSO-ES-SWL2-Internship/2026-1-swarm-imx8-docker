# --- Yocto/BitBake build state (large, fully regenerable) ---
# sources/ and .repo/ are managed by the `repo` tool per the manifest
# pinned in versions.txt — never hand-edited, and not worth duplicating
# upstream layer history into this repo.
yocto-builds/.repo/
yocto-builds/sources/
yocto-builds/downloads/

# Per-build output: compiled artifacts, shared-state cache, and
# bitbake's parse cache. Regenerated by `bitbake <image>`.
yocto-builds/build_*/tmp/
yocto-builds/build_*/sstate-cache/
yocto-builds/build_*/cache/

# README's alternate ${DOCKER_WORKDIR}/imx-<VERSION>/ layout, unused
# here but ignored defensively in case it's ever populated.
yocto-builds/imx-*/tmp/
yocto-builds/imx-*/sstate-cache/
yocto-builds/imx-*/cache/
yocto-builds/imx-*/downloads/
yocto-builds/imx-*/sources/

# --- Editor/session cruft ---
*.swp
*.swo
.vscode/
